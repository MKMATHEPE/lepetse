# Example only. Export these variables in your shell or IDE; Spring does not load this file automatically.
DB_URL=jdbc:postgresql://127.0.0.1:5432/lepetse
DB_USERNAME=lepetse
DB_PASSWORD=replace-with-your-local-password
SERVER_ADDRESS=127.0.0.1
PORT=8080
RFQ_STORAGE_DIRECTORY=./var/rfq-files
# Enable only when deployed behind HTTPS.
SESSION_COOKIE_SECURE=false
# First owner account only: follow ADMIN.md; never put a plain password here.
# ADMIN_BOOTSTRAP_USERNAME=
# ADMIN_BOOTSTRAP_PASSWORD_HASH=

# Configure privately to print the bank account number on quotations.
# QUOTATION_BANK_ACCOUNT_NUMBER=
